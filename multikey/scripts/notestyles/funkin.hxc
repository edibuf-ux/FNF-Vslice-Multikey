import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;
import flixel.FlxG;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.data.animation.AnimationDataUtil;
import funkin.util.Constants;
import haxe.Json;
import funkin.util.assets.FlxAnimationUtil;

class FunkinNoteStyle extends NoteStyle
{
    public var multikeyData = null;
	function new() {
		super('funkin');

        var path = Paths.file("data/multikeyData/" + this.id + ".json");
        if (Assets.exists(path)) {
            multikeyData = Json.parse(Assets.getText(path));
        } else {
            throwMultikeyError("Missing multikey data json");
        }
        validateMultikeyData();
        generateOffsets();
	}

    function validateMultikeyData() {

        if (multikeyData.keyData == null || multikeyData.keyData.length == 0) throwMultikeyError("No Key data found");
        if (multikeyData.splashData == null || multikeyData.splashData.length == 0) throwMultikeyError("No splash data found");
        if (multikeyData.holdCoverData == null || multikeyData.holdCoverData.length == 0) throwMultikeyError("No hold cover data found");
        if (multikeyData.strumNames == null || multikeyData.strumNames.length == 0) throwMultikeyError("No strum name data found");
        if (multikeyData.noteColors == null || multikeyData.noteColors.length == 0) throwMultikeyError("No note color data found");
        if (multikeyData.noteDirections == null || multikeyData.noteDirections.length == 0) throwMultikeyError("No note direction data found");
        
        if (multikeyData.notePrefix == null) multikeyData.notePrefix = "note";
        if (multikeyData.staticPrefix == null) multikeyData.staticPrefix = "static";
        if (multikeyData.pressPrefix == null) multikeyData.pressPrefix = "press";
        if (multikeyData.confirmPrefix == null) multikeyData.confirmPrefix = "confirm";

        var keyCount = 0;
        for (data in multikeyData.keyData) {
            keyCount++;

            for (index in data.noteDirectionIndexes) {
                if (index > multikeyData.strumNames.length-1) throwMultikeyError("Note direction index too high for strum names!" + " (Keycount: " + keyCount + ", Index: " + index + ", Array Length: " + multikeyData.strumNames.length + ")");
                if (index > multikeyData.noteColors.length-1) throwMultikeyError("Note direction index too high for note colors!" + " (Keycount: " + keyCount + ", Index: " + index + ", Array Length: " + multikeyData.noteColors.length + ")");
                if (index > multikeyData.noteDirections.length-1) throwMultikeyError("Note direction index too high for note directions!" + " (Keycount: " + keyCount + ", Index: " + index + ", Array Length: " + multikeyData.noteDirections.length + ")");
            }

            for (index in data.singDirectionIndexes) {
                if (index > 3) throwMultikeyError("Sing direction index too high!" + "(Keycount: " + keyCount + ", Index: " + index + ", Max Index: 3)");
            }

            if (data.noteDirectionIndexes.length != keyCount) throwMultikeyError("Mismatching note direction array length for keycount!" + " (Keycount: " + keyCount + ", Array Length: " + data.noteDirectionIndexes.length + ")");
            if (data.singDirectionIndexes.length != keyCount) throwMultikeyError("Mismatching sing direction array length for keycount!" + " (Keycount: " + keyCount + ", Array Length: " + data.singDirectionIndexes.length + ")");

            if (data.noteScale == null) data.noteScale = 1.0;
            if (data.noteSpacing == null) data.noteSpacing = 1.0;
            if (data.noteXOffset == null) data.noteXOffset = 0.0;
            if (data.strumlineOffsets == null) data.strumlineOffsets = [0.0, 0.0];
            if (data.holdNoteOffsets == null) data.holdNoteOffsets = [0.0, 0.0];
            if (data.holdCoverOffsets == null) data.holdCoverOffsets = [0.0, 0.0];
            if (data.splashOffsets == null) data.splashOffsets = [0.0, 0.0];
        }

        //key indexes are different from key counts, you can which means you can share multiple note colors by using the same index
        var keyIndex = 0;
        for (data in multikeyData.splashData) {
            if (data.length == 0) throwMultikeyError("Splash for key index '" + keyIndex + "' has no animations?");
            keyIndex++;
        }

        keyIndex = 0;
        for (data in multikeyData.holdCoverData) {
            if (data.start == null) throwMultikeyError("No start animation for hold cover at key index '" + keyIndex + "'");
            if (data.hold == null) throwMultikeyError("No hold animation for hold cover at key index '" + keyIndex + "'");
            if (data.end == null) throwMultikeyError("No end animation for hold cover at key index '" + keyIndex + "'");
            keyIndex++;
        }

        var maxNoteColors = multikeyData.noteColors.length;
        if (maxNoteColors != multikeyData.strumNames.length) throwMultikeyError("Mismatching strum names array length for note colors array!" + " (Note colors length: " + maxNoteColors + ", Strum names length: " + multikeyData.strumNames.length + ")");
        if (maxNoteColors != multikeyData.noteDirections.length) throwMultikeyError("Mismatching note directions array length for note colors array!" + " (Note colors length: " + maxNoteColors + ", Note directions length: " + multikeyData.noteDirections.length + ")");
        if (maxNoteColors != multikeyData.splashData.length) throwMultikeyError("Mismatching splash data array length for note colors array!" + " (Note colors length: " + maxNoteColors + ", Splash data length: " + multikeyData.splashData.length + ")");
        if (maxNoteColors != multikeyData.holdCoverData.length) throwMultikeyError("Mismatching hold cover data array length for note colors array!" + " (Note colors length: " + maxNoteColors + ", Hold cover data length: " + multikeyData.holdCoverData.length + ")");
    }

    inline function throwMultikeyError(error) {
        throw "Multikey Error for notestyle '" + this.id + "': " + error;
    }

    ///////////custom functions

    public inline function getMultikeyData() {
        return multikeyData;
    }
    public inline function getKeyCountData() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1];
    }
    public inline function getMaxKeyCount() {
        return multikeyData.keyData.length;
    }
    public inline function getMaxNoteColors() {
        return multikeyData.noteColors.length;
    }
    public inline function getMultikeyNoteDirectionName(dir) {
        return multikeyData.noteDirections[multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT]];
    }
    public inline function getMultikeyStrumDirectionName(dir) {
        return multikeyData.strumNames[multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT]];
    }
    public inline function getMultikeySingDirection(dir) {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].singDirectionIndexes[dir % Strumline.KEY_COUNT];
    }
    public inline function getMultikeyNoteColor(dir) {
        return multikeyData.noteColors[multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT]];
    }
    public inline function getMultikeyNoteDirectionIndex(dir) {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT];
    }
    public inline function getMultikeySplashData(dir) {
        return multikeyData.splashData[multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT]];
    }
    public inline function getMultikeyHoldCoverData(dir) {
        return multikeyData.holdCoverData[multikeyData.keyData[Strumline.KEY_COUNT-1].noteDirectionIndexes[dir % Strumline.KEY_COUNT]];
    }
    public inline function getMultikeyNoteScale() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].noteScale;
    }
    public inline function getMultikeyNoteSpacing() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].noteSpacing;
    }
    public inline function getMultikeyNoteXOffset() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].noteXOffset;
    }
    public inline function getMultikeySplashXOffset() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].splashOffsets[0];
    }
    public inline function getMultikeySplashYOffset() {
        return multikeyData.keyData[Strumline.KEY_COUNT-1].splashOffsets[1];
    }

    ///////////overrides

    override function getNoteScale() {
        var scale = super.getNoteScale();
        return scale * getMultikeyNoteScale();
    }
    override function getStrumlineScale() {
        var scale = super.getStrumlineScale();
        return scale * getMultikeyNoteScale();
    }
    override function getSplashScale() {
        var scale = super.getSplashScale();
        return scale * getMultikeyNoteScale();
    }
    override function fetchHoldNoteScale() {
        var scale = super.fetchHoldNoteScale();
        return scale * getMultikeyNoteScale();
    }

    //these are precalculated to prevent an issue with the offset array from the super not resetting properly
    var _strumlineOffsets = [];
    var _splashOffsets = [];
    var _holdCoverOffsets = [];
    var _holdNoteOffsets = [];
    override public function getStrumlineOffsets() { return _strumlineOffsets[Strumline.KEY_COUNT-1]; }
    override public function getSplashOffsets() { return _splashOffsets[Strumline.KEY_COUNT-1]; }
    override public function getHoldCoverOffsets() { return _holdCoverOffsets[Strumline.KEY_COUNT-1]; }
    override public function getHoldNoteOffsets() { return _holdNoteOffsets[Strumline.KEY_COUNT-1]; }
    
    function generateOffsets() {
        for (i in 0...getMaxKeyCount()) {
            _strumlineOffsets.push(addOffsetArrays(multikeyData.keyData[i].strumlineOffsets, _data?.assets?.noteStrumline?.offsets ?? fallback?.getStrumlineOffsets() ?? [0.0, 0.0]));
            _splashOffsets.push(addOffsetArrays(multikeyData.keyData[i].splashOffsets, _data?.assets?.noteSplash?.offsets ?? fallback?.getSplashOffsets() ?? [0.0, 0.0]));
            _holdCoverOffsets.push(addOffsetArrays(multikeyData.keyData[i].holdCoverOffsets, _data?.assets?.holdNoteCover?.offsets ?? fallback?.getHoldCoverOffsets() ?? [0.0, 0.0]));
            _holdNoteOffsets.push(addOffsetArrays(multikeyData.keyData[i].holdNoteOffsets, _data?.assets?.holdNote?.offsets ?? fallback?.getHoldNoteOffsets() ?? [0.0, 0.0]));
        }
    }
    inline function addOffsetArrays(a, b) {
        return [a[0] + b[0], a[1] + b[1]];
    }

    override function getStrumlineAnimationData(dir) {
        var noteName = getMultikeyNoteDirectionName(dir);
        var staticName = multikeyData.staticPrefix + getMultikeyStrumDirectionName(dir);
        var pressName = multikeyData.pressPrefix + noteName;
        var confirmName = multikeyData.confirmPrefix + noteName;

        var result = [
            AnimationDataUtil.toNamed({prefix: staticName},"static"),
            AnimationDataUtil.toNamed({prefix: pressName}, "press"),
            AnimationDataUtil.toNamed({prefix: confirmName}, "confirm"),
            AnimationDataUtil.toNamed({prefix: confirmName}, "confirm-hold")
        ];
		return result;
    }

    override function buildNoteAnimations(target) {
        for (i in 0...Strumline.KEY_COUNT) {
            var noteName = getMultikeyNoteDirectionName(i);
            target.animation.addByPrefix(noteName + "Scroll", multikeyData.notePrefix + noteName);
        }
    }

    public function buildHoldCoverSprite(target:NoteHoldCover):Void
    {
        // NoteHoldCover has "glow" and "sparks". Right now it only implements "glow"
        // but "sparks" I believe is meant to be used for the ending of the hold note
        var glowAtlas:Null<FlxFramesCollection> = buildHoldCoverFrames(false);
        if (glowAtlas == null)
        {
            throw 'Could not load spritesheet for note style: $id';
        }
        target.glow.frames = glowAtlas;

        target.antialiasing = !(_data.assets.holdNoteCover?.isPixel ?? false);
        target.glow.antialiasing = !(_data.assets.holdNoteCover?.isPixel ?? false);
        //custom change start
        var scale = (_data.assets.holdNoteCover?.scale ?? 1.0) * getMultikeyNoteScale();
        target.scale.set(scale, scale);
        //custom change end
        target.updateHitbox();
        target.glow.updateHitbox();

        buildHoldCoverAnimations(target);
    }

    override function buildHoldCoverFrameForDirection(direction)
    {
        //custom change start
        var directionData = getMultikeyHoldCoverData(direction);
        //custom change end
        if (directionData == null) return null;

        var holdCoverAssetPath:Null<String> = getHoldCoverDirectionAssetPath(direction) ?? fallback?.getHoldCoverDirectionAssetPath(direction);
        if (holdCoverAssetPath == null)
        {
            FlxG.log.warn('Hold Note Cover asset path not found: ${id}');
            return null;
        }

        if (!FunkinSprite.isTextureCached(Paths.image(holdCoverAssetPath)))
        {
            FlxG.log.warn('Hold Note Cover texture not cached: ${holdCoverAssetPath}');
        }

        var atlas:FlxFramesCollection = Paths.getSparrowAtlas(holdCoverAssetPath, getAssetLibrary(getHoldCoverDirectionAssetPath(direction, true)));
        if (atlas == null) return null;

        atlas.parent.persist = true;

        return atlas;
    }

    override function getHoldCoverDirectionAssetPath(direction, raw = false) {
        if (raw)
        {
            //custom change start
            var rawPath = getMultikeyHoldCoverData(direction).assetPath;
            //custom change end

            // we don't want to fallback directly just yet, we want to check our root assetpath first
            if (rawPath == null) return getHoldCoverRootAssetPath(direction, true);
            return rawPath;
        }

        var parts:Array<String> = getHoldCoverDirectionAssetPath(direction, true)?.split(Constants.LIBRARY_SEPARATOR) ?? [];
        if (parts.length == 0) return null;
        if (parts.length == 1) return getHoldCoverDirectionAssetPath(direction, true);
        return parts[1];
    }

    override function fetchHoldCoverAnimationData(dir) {
        var color = getMultikeyNoteColor(dir);
        var data = getMultikeyHoldCoverData(dir);
        return [
            AnimationDataUtil.toNamed(data.start, "holdCoverStart" + color),
            AnimationDataUtil.toNamed(data.hold, "holdCover" + color),
            AnimationDataUtil.toNamed(data.end, "holdCoverEnd" + color)
        ];
    }

    override function buildSplashAnimations(target:NoteSplash):Void
    {
        for (i in 0...Strumline.KEY_COUNT) {
            var animData = AnimationDataUtil.toNamedArray(getMultikeySplashData(i), "splash" + getMultikeyNoteDirectionName(i).toUpperCase());
            for (anim in animData) {
                FlxAnimationUtil.addAtlasAnimation(target, anim);
            }
        }
    }

    //probably not the best way of doing this, but its the easiest option while not messing with much of the cover code
    public function forceChangeHoldCoverAnim(target, oldColor, newDir) {
        var data = getMultikeyHoldCoverData(newDir);
        var animData = [
            AnimationDataUtil.toNamed(data.start, "holdCoverStart" + oldColor),
            AnimationDataUtil.toNamed(data.hold, "holdCover" + oldColor),
            AnimationDataUtil.toNamed(data.end, "holdCoverEnd" + oldColor)
        ];
        animData[1].looped = true;
        FlxAnimationUtil.addAtlasAnimations(target.glow, animData);
    }
}