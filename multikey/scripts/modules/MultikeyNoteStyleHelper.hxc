import funkin.Paths;
import funkin.modding.module.Module;
import funkin.util.VersionUtil;
import haxe.Json;

typedef MultikeyNoteStyleKeyCountData =
{
    var noteDirectionIndexes:Array<Int>;

    var singDirectionIndexes:Array<Int>;

    var noteScale:Float;

    var noteSpacing:Float;

    var noteXOffset:Float;

    var strumlineOffsets:Array<Float>;

    var holdNoteOffsets:Array<Float>;

    var holdCoverOffsets:Array<Float>;

    var splashOffsets:Array<Float>;
}

typedef MultikeyNoteStyleData = 
{
    var version:String;

    var noteDirections:Array<String>;

    var noteColorsRGB:Array<String>;

    var noteAnimations:Array<UnnamedAnimationData>;
    
    var strumStaticAnimations:Array<UnnamedAnimationData>;

    var strumPressAnimations:Array<UnnamedAnimationData>;

    var strumConfirmAnimations:Array<UnnamedAnimationData>;

    var strumConfirmHoldAnimations:Array<UnnamedAnimationData>;

    var keyData:Array<MultikeyNoteStyleKeyCountData>;

    var splashData:Array<Array<UnnamedAnimationData>>;

    var holdCoverData:NoteStyleData_HoldNoteCoverDirectionData;
}

class MultikeyNoteStyleHelper extends Module
{
    static var MULTIKEY_DATA_VERSION:Version = "1.0.0";
    static var MULTIKEY_DATA_VERSION_RULE:VersionRule = "1.0.x";

    public function new() 
    {
        super("MultikeyNoteStyleHelper");
    }

    var _currentID:String = "";
    public static function initMultikeyData(noteStyle)
    {
        _currentID = noteStyle.id;

        var multikeyData:MultikeyNoteStyleData = null;
        var path = Paths.file("data/multikeyData/" + _currentID + ".json");
        if (Assets.exists(path)) {
            multikeyData = Json.parse(Assets.getText(path));
        } else {
            throwMultikeyError("Missing multikey data json");
        }

        validateMultikeyData(multikeyData);
        noteStyle.multikeyData = multikeyData;
        noteStyle.generateMultikeyOffsets();
    }

    static function validateMultikeyData(multikeyData) 
    {
        if (multikeyData.version == null) throwMultikeyError("No version found");

        if (!VersionUtil.validateVersionStr(multikeyData.version, MULTIKEY_DATA_VERSION_RULE))
        {
            throwMultikeyError("Mismatching version! (Expected: " + MULTIKEY_DATA_VERSION_RULE + ", Found: " + multikeyData.version + ")");
        }

        if (multikeyData.keyCountData == null || multikeyData.keyCountData.length == 0) throwMultikeyError("No Key data found");
        if (multikeyData.splashData == null || multikeyData.splashData.length == 0) throwMultikeyError("No splash data found");
        if (multikeyData.holdCoverData == null || multikeyData.holdCoverData.length == 0) throwMultikeyError("No hold cover data found");
        if (multikeyData.noteColorsRGB == null || multikeyData.noteColorsRGB.length == 0) throwMultikeyError("No note rgb color data found");
        if (multikeyData.noteDirections == null || multikeyData.noteDirections.length == 0) throwMultikeyError("No note direction data found");
        
        if (multikeyData.noteAnimations == null || multikeyData.noteAnimations.length == 0) throwMultikeyError("No note animation data found");
        if (multikeyData.strumStaticAnimations == null || multikeyData.strumStaticAnimations.length == 0) throwMultikeyError("No strum static animation data found");
        if (multikeyData.strumPressAnimations == null || multikeyData.strumPressAnimations.length == 0) throwMultikeyError("No strum press animation data found");
        if (multikeyData.strumConfirmAnimations == null || multikeyData.strumConfirmAnimations.length == 0) throwMultikeyError("No strum confirm animation data found");
        if (multikeyData.strumConfirmHoldAnimations == null || multikeyData.strumConfirmHoldAnimations.length == 0) throwMultikeyError("No strum confirm hold animation data found");

        var keyCount = 0;
        for (data in multikeyData.keyCountData) 
        {
            keyCount++;

            for (index in data.noteDirectionIndexes) 
            {
                if (index > multikeyData.noteDirections.length-1) throwMultikeyError("Note direction index too high for note directions!" + " (Keycount: " + keyCount + ", Index: " + index + ", Array Length: " + multikeyData.noteDirections.length + ")");
            }

            for (index in data.singDirectionIndexes) 
            {
                if (index > 3) throwMultikeyError("Sing direction index too high!" + "(Keycount: " + keyCount + ", Index: " + index + ", Max Index: 3)");
            }

            if (data.noteDirectionIndexes.length != keyCount) throwMultikeyError("Mismatching note direction array length for keycount!" + " (Keycount: " + keyCount + ", Array Length: " + data.noteDirectionIndexes.length + ")");
            if (data.singDirectionIndexes.length != keyCount) throwMultikeyError("Mismatching sing direction array length for keycount!" + " (Keycount: " + keyCount + ", Array Length: " + data.singDirectionIndexes.length + ")");

            if (data.noteScale == null) data.noteScale = 1.0;
            if (data.noteSpacing == null) data.noteSpacing = 1.0;
            if (data.noteXOffset == null) data.noteXOffset = 0.0;
            if (data.strumlineOffsets == null) data.strumlineOffsets = [0.0, 0.0];
            if (data.holdNoteOffsets == null) data.holdNoteOffsets = [0.0, 0.0];
            if (data.holdCoverOffsets == null) data.holdCoverOffsets = [0.0, 0.0];
            if (data.splashOffsets == null) data.splashOffsets = [0.0, 0.0];
        }

        //key indexes are different from key counts, you can which means you can share multiple note colors by using the same index
        var keyIndex = 0;
        for (data in multikeyData.splashData) 
        {
            if (data.length == 0) throwMultikeyError("Splash for key index '" + keyIndex + "' has no animations?");
            keyIndex++;
        }

        keyIndex = 0;
        for (data in multikeyData.holdCoverData) 
        {
            if (data.start == null) throwMultikeyError("No start animation for hold cover at key index '" + keyIndex + "'");
            if (data.hold == null) throwMultikeyError("No hold animation for hold cover at key index '" + keyIndex + "'");
            if (data.end == null) throwMultikeyError("No end animation for hold cover at key index '" + keyIndex + "'");
            keyIndex++;
        }

        var maxNoteDirections = multikeyData.noteDirections.length;
        if (maxNoteDirections != multikeyData.noteColorsRGB.length) throwMultikeyError("Mismatching note rgb color array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Note rgb colors length: " + multikeyData.noteColorsRGB.length + ")");

        if (maxNoteDirections != multikeyData.noteAnimations.length) throwMultikeyError("Mismatching note animations array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Note animations length: " + multikeyData.noteAnimations.length + ")");
        if (maxNoteDirections != multikeyData.strumStaticAnimations.length) throwMultikeyError("Mismatching strum static animations array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Strum static animations length: " + multikeyData.strumStaticAnimations.length + ")");
        if (maxNoteDirections != multikeyData.strumPressAnimations.length) throwMultikeyError("Mismatching strum press animations array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Strum press animations length: " + multikeyData.strumPressAnimations.length + ")");
        if (maxNoteDirections != multikeyData.strumConfirmAnimations.length) throwMultikeyError("Mismatching strum confirm animations array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Strum confirm animations length: " + multikeyData.strumConfirmAnimations.length + ")");
        if (maxNoteDirections != multikeyData.strumConfirmHoldAnimations.length) throwMultikeyError("Mismatching strum confirm hold animations array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Strum confirm hold animations length: " + multikeyData.strumConfirmHoldAnimations.length + ")");

        if (maxNoteDirections != multikeyData.splashData.length) throwMultikeyError("Mismatching splash data array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Splash data length: " + multikeyData.splashData.length + ")");
        if (maxNoteDirections != multikeyData.holdCoverData.length) throwMultikeyError("Mismatching hold cover data array length for note directions array!" + " (Note directions length: " + maxNoteDirections + ", Hold cover data length: " + multikeyData.holdCoverData.length + ")");
    }

    static inline function throwMultikeyError(error) {
        throw "Multikey Error for notestyle '" + _currentID + "': " + error;
    }

    public static function prettyJsonString(d) {
        //stupid and messy but it will look nice and still easy to manually edit

        var string = "{";

        function doPrettyLineStr(ind, n, i) return ind+'"'+n+'": "' + i + '"';
        function doPrettyLineArr(ind, n, i) {
            var shit = ind+'"'+n+'": [';
            var first = true;
            for (s in i) {
                shit += (first ? "" : ",") + '"' + s + '"';
                first = false;
            }
            return shit + "]";
        }
        function doPrettyLineRaw(ind, n, i) return ind+'"'+n+'": ' + i + '';

        string += doPrettyLineStr("\n\t","version", MULTIKEY_DATA_VERSION) + ",";
        string += doPrettyLineArr("\n\t","noteDirections", d.noteDirections) + ",";
        string += doPrettyLineArr("\n\t","noteColorsRGB", d.noteColorsRGB) + ",";

        string += '\n\t"noteAnimations": [';
        for (i in 0...d.noteAnimations.length) { string += "\n\t\t" + Json.stringify(d.noteAnimations[i]) + (i < d.noteAnimations.length-1 ? "," : "");}
        string += "\n\t],";

        string += '\n\t"strumStaticAnimations": [';
        for (i in 0...d.strumStaticAnimations.length) { string += "\n\t\t" + Json.stringify(d.strumStaticAnimations[i]) + (i < d.strumStaticAnimations.length-1 ? "," : "");}
        string += "\n\t],";

        string += '\n\t"strumPressAnimations": [';
        for (i in 0...d.strumPressAnimations.length) { string += "\n\t\t" + Json.stringify(d.strumPressAnimations[i]) + (i < d.strumPressAnimations.length-1 ? "," : "");}
        string += "\n\t],";
        
        string += '\n\t"strumConfirmAnimations": [';
        for (i in 0...d.strumConfirmAnimations.length) { string += "\n\t\t" + Json.stringify(d.strumConfirmAnimations[i]) + (i < d.strumConfirmAnimations.length-1 ? "," : "");}
        string += "\n\t],";

        string += '\n\t"strumConfirmHoldAnimations": [';
        for (i in 0...d.strumConfirmHoldAnimations.length) { string += "\n\t\t" + Json.stringify(d.strumConfirmHoldAnimations[i]) + (i < d.strumConfirmHoldAnimations.length-1 ? "," : "");}
        string += "\n\t],";

        string += '\n\t"keyCountData": [';
        for (i in 0...d.keyCountData.length) {
            string += "\n\t\t{";

            string += doPrettyLineRaw("\n\t\t\t","noteDirectionIndexes", d.keyCountData[i].noteDirectionIndexes) + ",";
            string += doPrettyLineRaw("\n\t\t\t","singDirectionIndexes", d.keyCountData[i].singDirectionIndexes) + ",";
            string += doPrettyLineRaw("\n\t\t\t","noteScale", d.keyCountData[i].noteScale) + ",";
            string += doPrettyLineRaw("\n\t\t\t","noteSpacing", d.keyCountData[i].noteSpacing) + ",";
            string += doPrettyLineRaw("\n\t\t\t","noteXOffset", d.keyCountData[i].noteXOffset) + ",";
            string += doPrettyLineRaw("\n\t\t\t","strumlineOffsets", d.keyCountData[i].strumlineOffsets) + ",";
            string += doPrettyLineRaw("\n\t\t\t","holdNoteOffsets", d.keyCountData[i].holdNoteOffsets) + ",";
            string += doPrettyLineRaw("\n\t\t\t","holdCoverOffsets", d.keyCountData[i].holdCoverOffsets) + ",";
            string += doPrettyLineRaw("\n\t\t\t","splashOffsets", d.keyCountData[i].splashOffsets);

            string += "\n\t\t}" + (i < d.keyCountData.length-1 ? "," : "");
        }
        string += "\n\t],";

        string += '\n\t"splashData": [';
        for (i in 0...d.splashData.length) {
            string += "\n\t\t[";

            for (a in 0...d.splashData[i].length) {
                string += "\n\t\t\t" + Json.stringify(d.splashData[i][a]) + (a < d.splashData[i].length-1 ? "," : "");
            }

            string += "\n\t\t]" + (i < d.splashData.length-1 ? "," : "");
        }
        string += "\n\t],";

        string += '\n\t"holdCoverData": [';
        for (i in 0...d.holdCoverData.length) {
            string += "\n\t\t{";

            if (d.holdCoverData[i].assetPath != null) string += doPrettyLineStr("\n\t\t\t","assetPath", d.holdCoverData[i].assetPath) + ",";
            string += doPrettyLineRaw("\n\t\t\t", "start", Json.stringify(d.holdCoverData[i].start)) + ",";
            string += doPrettyLineRaw("\n\t\t\t", "hold", Json.stringify(d.holdCoverData[i].hold)) + ",";
            string += doPrettyLineRaw("\n\t\t\t", "end", Json.stringify(d.holdCoverData[i].end));

            string += "\n\t\t}" + (i < d.holdCoverData.length-1 ? "," : "");
        }
        string += "\n\t]";


        string += "\n}";
    }
}