import flixel.FlxG;
import flixel.tweens.FlxTween;

import funkin.Paths;
import funkin.Preferences;
import funkin.Highscore;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.data.song.importer.FNFLegacyImporter;
import funkin.mobile.input.ControlsHandler;
import funkin.modding.ModStore;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.play.notes.Strumline;
import funkin.play.notes.ScriptedStrumline;
import funkin.play.song.Song;
import funkin.util.PlatformUtil;
import funkin.util.HostPlatform;
import funkin.util.FileUtil;
import funkin.util.Constants;
import funkin.util.SerializerUtil;
import funkin.ui.FullScreenScaleMode;
import funkin.ui.debug.charting.ChartEditorState;
import funkin.ui.debug.charting.handlers.ChartEditorThemeHandler;
import funkin.ui.debug.charting.handlers.ChartEditorToolboxHandler;

import haxe.Timer;
import haxe.Json;
import haxe.ui.RuntimeComponentBuilder;

import funkin.util.tools.StringTools as FunkinStringTools;
import StringTools;

import MultikeyMobileControlScheme;
import MultikeyKeyCountRegistry;
import MultikeySustainFixer;

class Multikey extends Module
{
    public static var platform:HostPlatform;
    public static var onMobile:Bool = false;
    public function new() 
    {
        super("Multikey");

        //#if mobile doesnt seem to work
        platform = PlatformUtil.detectHostPlatform();
        onMobile = platform == HostPlatform.ANDROID || platform == HostPlatform.IOS;
    }

    public function setKeyCount(keyCount:Int) 
    {
        trace("Setting key count to " + keyCount + "!");

        Strumline.KEY_COUNT = keyCount;
        Strumline.DIRECTIONS = [];
        for (i in 0...Strumline.KEY_COUNT) Strumline.DIRECTIONS.push(i);

        ChartEditorState.STRUMLINE_SIZE = keyCount;
        ChartEditorThemeHandler.TOTAL_COLUMN_COUNT = keyCount * 2 + 1;
        ChartEditorState.NOTE_PREVIEW_X_POS = -(keyCount * ChartEditorState.GRID_SIZE) + 480;
        FNFLegacyImporter.STRUMLINE_SIZE = keyCount;
    }

    var usingMultikey:Bool = false;
    override function onStateChangeBegin(e) 
    {
        if (usingMultikey) 
        {
            setKeyCount(4);
            if (onMobile) 
            {
                Preferences.controlsScheme = ModStore.get("MultikeyTempOriginalControlScheme");
            }
        }
        FlxG.signals.preStateCreate.addOnce(onStateChange);
		usingMultikey = false;
	}
    override function onStateChangeEnd(e) 
    {
		if (Std.isOfType(e.targetState, PlayState) || Std.isOfType(e.targetState, ChartEditorState)) 
        {
            usingMultikey = true;
        }

        if (Std.isOfType(e.targetState, ChartEditorState)) 
        {
            charterPostCreate(e.targetState);
            initKeyCountToolbox(e.targetState);
        }
	}

    public function onStateChange(state) 
    {
        if (Std.isOfType(state, PlayState)) 
        {
            setKeyCount(getKeyCount(state));
            setupMultikeyStrumlines(state, false);
            _regenNoteData = true;
        } 
        else if (Std.isOfType(state, ChartEditorState)) 
        {
            setKeyCount(getKeyCount(state));

            //TODO: change this to use maxkeycount im lazy rn
            ChartEditorThemeHandler.TOTAL_COLUMN_COUNT = 9 * 2 + 1; //weird hack to fix the bitmap, if it starts at a lower number it would never get bigger for whatever reason
        }
    }
    override public function onSubStateOpenEnd(event)
    {
        super.onSubStateOpenEnd(event);
        if (Std.isOfType(FlxG.state, ChartEditorState) && PlayState.instance == event.targetState) 
        {
            setKeyCount(getKeyCount(PlayState.instance));
            setupMultikeyStrumlines(PlayState.instance, true);
            _regenNoteData = true;
        }
    }

    override public function onSongRetry(event)
    {
        super.onSongRetry(event);

        var keyCount = getKeyCount(PlayState.instance);
        if (keyCount != Strumline.KEY_COUNT) 
        {
            setKeyCount(keyCount);
            setupMultikeyStrumlines(PlayState.instance, true);
            
        }
        _regenNoteData = true;
    }

    public function getKeyCount(state) 
    {
        if (Std.isOfType(state, ChartEditorState)) 
        {
            if (state.params == null) return 4;
            return MultikeyKeyCountRegistry.fetchEntry(state.params.targetSongId, state.params.targetSongVariation, state.params.targetSongDifficulty);
        } 

        return MultikeyKeyCountRegistry.fetchEntry(state.currentSong.id, state.currentVariation, state.currentDifficulty);
    }

    public function setupMultikeyStrumlines(state, retry = false) 
    {
        state.playerStrumline.destroy();
        state.opponentStrumline.destroy();

        state.playerStrumline = ScriptedStrumline.init('MultikeyStrumline', state.noteStyle, !state.isBotPlayMode, state.currentChart?.scrollSpeed);
        state.opponentStrumline = ScriptedStrumline.init('MultikeyStrumline', state.noteStyle, false, state.currentChart?.scrollSpeed);

        state.opponentStrumline.setNoteSpacing(state.noteStyle.scriptCall("getMultikeyNoteSpacing"));
        state.playerStrumline.setNoteSpacing(state.noteStyle.scriptCall("getMultikeyNoteSpacing"));

        if (retry) 
        {
            if (Strumline.KEY_COUNT != 4) Preferences.controlsScheme = "Four Lanes";
            state.initStrumlines();
            fixMobileArrows(state);
        } 
        else 
        {
            if (onMobile)
            {
                ModStore.register("MultikeyTempOriginalControlScheme", Preferences.controlsScheme);
                if (Strumline.KEY_COUNT != 4) Preferences.controlsScheme = "Four Lanes"; //stops it from crashing
            }
        }
    }

    function fixMobileArrows(state, retry = false) {
        if (!onMobile) return;

        var isArrows = Strumline.KEY_COUNT == 4 ? ModStore.get("MultikeyTempOriginalControlScheme") == "Arrows" : FlxG.save.data.multikeyControlScheme == MultikeyMobileControlScheme.ARROWS;

        var playerStrumline = state.playerStrumline;
        var opponentStrumline = state.opponentStrumline;

        //base positions from initStrumlines()
        final cutoutSize = FullScreenScaleMode.gameCutoutSize.x / 2.5;
        
        playerStrumline.x = (FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET) + (cutoutSize / 2.0);
        playerStrumline.y = Preferences.downscroll ? FlxG.height - playerStrumline.strumlineNotes.height - Constants.STRUMLINE_Y_OFFSET - state.noteStyle.getStrumlineOffsets()[1] : Constants.STRUMLINE_Y_OFFSET;

        opponentStrumline.x = Constants.STRUMLINE_X_OFFSET + cutoutSize;
        opponentStrumline.y = Preferences.downscroll ? FlxG.height - opponentStrumline.strumlineNotes.height - Constants.STRUMLINE_Y_OFFSET - state.noteStyle.getStrumlineOffsets()[1] : Constants.STRUMLINE_Y_OFFSET;
        
        if (isArrows && !ControlsHandler.usingExternalInputDevice)
        {
            //positions from initNoteHitbox()
            final amplification:Float = (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);
            final playerStrumlineScale:Float = ((FlxG.height / FlxG.width) * 1.95) * amplification;
            final playerNoteSpacing:Float = ((FlxG.height / FlxG.width) * 2.8) * amplification;

            if (!retry) {
                playerStrumline.strumlineScale.set(playerStrumlineScale, playerStrumlineScale);
                playerStrumline.setNoteSpacing(playerNoteSpacing * state.noteStyle.scriptCall("getMultikeyNoteSpacing"));
                for (strum in playerStrumline)
                {
                    strum.width *= 2;
                }
                opponentStrumline.enterMiniMode(0.4 * amplification);
            }

            playerStrumline.x = (FlxG.width - playerStrumline.width) / 2 + Constants.STRUMLINE_X_OFFSET;
            playerStrumline.y = (FlxG.height - playerStrumline.strumlineNotes.height) * 0.95 - Constants.STRUMLINE_Y_OFFSET;
            if (state.currentChart?.noteStyle != "pixel")
            {
                if (platform == HostPlatform.ANDROID) playerStrumline.y += 10;
            }
            else
            {
                playerStrumline.y -= 10;
            }
            opponentStrumline.y = Constants.STRUMLINE_Y_OFFSET * 0.3;
            opponentStrumline.x -= 30;
        }
        //fix health bar
        var healthBarYPos:Float = (isArrows && !ControlsHandler.usingExternalInputDevice || Preferences.downscroll) ? FlxG.height * 0.1 : FlxG.height * 0.9;
        state.healthBarBG.y = healthBarYPos;
        state.healthBar.y = state.healthBarBG.y + 4;
        state.scoreText.y = state.healthBarBG.y + 30;
        state.iconP2.y = state.healthBar.y - (state.iconP2.height / 2);
        state.iconP1.y = state.healthBar.y - (state.iconP1.height / 2);

        //reset fade if needed
        var needsFade = playerStrumline.strumlineNotes.members[0].alpha == 0.0;
        if (needsFade) {
            for (i in 0...playerStrumline.strumlineNotes.members.length) {
                //playerStrumline.strumlineNotes.members[i].y += 10;
                FlxTween.cancelTweensOf(playerStrumline.strumlineNotes.members[i]);
            }
            for (i in 0...opponentStrumline.strumlineNotes.members.length) {
                //opponentStrumline.strumlineNotes.members[i].y += 10;
                FlxTween.cancelTweensOf(opponentStrumline.strumlineNotes.members[i]);
            }
            playerStrumline.fadeInArrows();
            opponentStrumline.fadeInArrows();
        }

        //set back to original to make sure it doesnt break
        Preferences.controlsScheme = ModStore.get("MultikeyTempOriginalControlScheme");
    }

    var _regenNoteData = false;
    function onUpdate(event)
    {
        super.onUpdate(event);

        if (PlayState.instance != null) 
        {
            if (_regenNoteData)
            {
                _regenNoteData = false;
                fixChart();
            }
        } 
        else if (Std.isOfType(FlxG.state, ChartEditorState)) 
        {
            charterUpdate();
        }
    }

    function fixChart() {
        trace("Regenerating notes for multikey");
        PlayState.instance.playerStrumline.clean();
        PlayState.instance.opponentStrumline.clean();

        Highscore.tallies.combo = 0;
        Highscore.tallies.totalNotes = 0;

        var playerNoteData = [];
        var opponentNoteData = [];
        var _g = 0;
        var _g1 = PlayState.instance.get_currentChart().notes;
        while (_g < _g1.length) 
        {
            var songNote = _g1[_g];
            ++_g;

            switch (Math.floor(songNote.data / Strumline.KEY_COUNT)) 
            {
                case 0:
                    playerNoteData.push(songNote);
                    Highscore.tallies.totalNotes++;
                case 1:
                    opponentNoteData.push(songNote);
            }
        }

        PlayState.instance.playerStrumline.applyNoteData(playerNoteData);
        PlayState.instance.opponentStrumline.applyNoteData(opponentNoteData);
        fixMobileArrows(PlayState.instance);
    }

    //do note splashes
    override public function onNoteHit(event)
    {
        super.onNoteHit(event);

        if (event.doesNotesplash)
        {
            PlayState.instance.playerStrumline.playNoteSplash(event.note.noteData.data % Strumline.KEY_COUNT);
            event.doesNotesplash = false;
        }
    }

    ///////////////////////////

    var _lastSongID = "";
    var _lastVariation = "";
    var _lastDifficulty = "";

    function charterPostCreate(state) {

        ChartEditorThemeHandler.TOTAL_COLUMN_COUNT = Strumline.KEY_COUNT * 2 + 1;
        ChartEditorThemeHandler.updateGridBitmap(state);
        state.gridTiledSprite.width = state.gridBitmap.width;

        var i = 0;
        for (waveform in state.audioWaveforms)
        {
            if (i == 0)
            {
                var offset = (Strumline.KEY_COUNT * ChartEditorState.GRID_SIZE)-160;
                waveform.x = 840 + offset;
            }
            else if (i == 1)
            {
                var offset = -(Strumline.KEY_COUNT * ChartEditorState.GRID_SIZE)+160;
                waveform.x = 360 + offset;
            }
            i++;
        }
        state.buttonSelectOpponent.x = ChartEditorState.GRID_X_POS;
        state.buttonSelectOpponent.width = ChartEditorState.GRID_SIZE * Strumline.KEY_COUNT;
        state.buttonSelectPlayer.width = ChartEditorState.GRID_SIZE * Strumline.KEY_COUNT;
        state.buttonSelectPlayer.x = state.buttonSelectOpponent.x + state.buttonSelectOpponent.width;
        state.buttonSelectEvent.x = state.buttonSelectPlayer.x + state.buttonSelectPlayer.width;

        state.gridTiledSprite.x = ChartEditorState.GRID_X_POS;
        state.measureTicks.x = state.gridTiledSprite.x - ChartEditorState.GRID_SIZE;

        state.gridPlayhead.x = ChartEditorState.GRID_X_POS;
        state.gridPlayhead.members[0].setGraphicSize(ChartEditorState.GRID_SIZE * (ChartEditorState.STRUMLINE_SIZE * 2 + 1) + ChartEditorState.PLAYHEAD_SCROLL_AREA_WIDTH, ChartEditorState.PLAYHEAD_HEIGHT);
        state.gridPlayhead.members[0].updateHitbox();

        state.notePreview.x = ChartEditorState.NOTE_PREVIEW_X_POS;
        state.notePreviewPlayhead.x = state.notePreview.x;

        state.handleHealthIcons();

        _lastSongID = state.currentSongId;
        _lastVariation = state.selectedVariation;
        _lastDifficulty = state.selectedDifficulty;
    }

    var charterVisibleHoldNoteSpriteData = [];
    function charterUpdate() {
        updateCharterKeyCount();

        for (noteSprite in FlxG.state.renderedNotes.members) 
        {
            if (Strumline.KEY_COUNT == 4 || noteSprite == null || noteSprite.noteData == null || !noteSprite.exists || !noteSprite.visible) continue;

            if (StringTools.startsWith(noteSprite.animation.name, "tap")) 
            {    
                var noteStyle = NoteStyleRegistry.instance.fetchEntry(noteSprite.noteStyle);
                var prefix = FunkinStringTools.toTitleCase(noteStyle.id);
                var noteName = noteStyle.scriptCall("getMultikeyNoteDirectionName", [noteSprite.noteData.data]);
                var noteIndex = noteStyle.scriptCall("getMultikeyNoteDirectionIndex", [noteSprite.noteData.data]);
                noteSprite.animation.addByPrefix(prefix + noteName + "Scroll", prefix + noteStyle.scriptCall("getMultikeyData").noteAnimations[noteIndex].prefix);
                noteSprite.animation.play(prefix + noteName + "Scroll");
            }
        }

        //this might look ugly, but its better than updating the sustain every frame
        for (data in charterVisibleHoldNoteSpriteData) 
        {
            data.seenThisFrame = false;
        }
        for (holdNoteSprite in FlxG.state.renderedHoldNotes.members)
        {
            if (holdNoteSprite == null || holdNoteSprite.noteData == null || !holdNoteSprite.exists || !holdNoteSprite.visible) continue;

            var foundData = null;
            for (data in charterVisibleHoldNoteSpriteData) 
            {
                if (data.holdNoteSprite == holdNoteSprite) 
                {
                    data.seenThisFrame = true;
                    foundData = data;
                    break;
                }
            }

            var updateSustainStuff = false;

            if (foundData != null) 
            {
                if (foundData.sustainLength != holdNoteSprite.sustainLength || foundData.noteDirection != holdNoteSprite.noteData.data) 
                {
                    updateSustainStuff = true;
                }
                holdNoteSprite.updateHitbox();
            } 
            else 
            {
                updateSustainStuff = true;
                foundData = {
                    holdNoteSprite: holdNoteSprite,
                    sustainLength: holdNoteSprite.sustainLength,
                    noteDirection: holdNoteSprite.noteData.data,
                    seenThisFrame: true
                };
                charterVisibleHoldNoteSpriteData.push(foundData);
            }

            if (updateSustainStuff) 
            {
                var noteStyle = NoteStyleRegistry.instance.fetchEntry(holdNoteSprite.noteStyle);
                var maxNoteDirections = noteStyle.scriptCall("getMaxNoteDirections");

                if (holdNoteSprite.noteData != null) holdNoteSprite.noteDirection = holdNoteSprite.noteData.data % Strumline.KEY_COUNT;
                MultikeySustainFixer.fixSustain(holdNoteSprite, noteStyle, maxNoteDirections, true);
                holdNoteSprite.updateHitbox();

                foundData.sustainLength = holdNoteSprite.sustainLength;
                foundData.noteDirection = holdNoteSprite.noteData.data;

                //trace("update sustain " + Timer.stamp() + " : " + charterVisibleHoldNoteSpriteData.length);
            }

        }

        for (data in charterVisibleHoldNoteSpriteData) 
        {
            if (!data.seenThisFrame) charterVisibleHoldNoteSpriteData.remove(data);
        }
    }

    function updateCharterKeyCount() {
        var state = FlxG.state;
        if (_lastSongID != state.currentSongId || _lastVariation != state.selectedVariation || _lastDifficulty != state.selectedDifficulty) {
            
            var oldKeyCount = Strumline.KEY_COUNT;
            var newKeyCount = MultikeyKeyCountRegistry.fetchEntry(state.currentSongId, state.selectedVariation, state.selectedDifficulty);

            if (newKeyCount != oldKeyCount) {
                setCharterKeyCount(newKeyCount);
                refreshKeyCountToolbox();
            }
            keycountToolboxLabelKeycount.text = "Key Count for " + FunkinStringTools.toTitleCase(state.selectedDifficulty) + (state.selectedVariation != Constants.DEFAULT_VARIATION ? " ("+FunkinStringTools.toTitleCase(state.selectedVariation)+")" : "");
            _lastSongID = state.currentSongId;
            _lastVariation = state.selectedVariation;
            _lastDifficulty = state.selectedDifficulty;
        }
    }
    function setCharterKeyCount(k:Int) {
        var state = FlxG.state;
        setKeyCount(k);
        charterPostCreate(state);
        charterVisibleHoldNoteSpriteData = [];
        
        //force note positions to update
        state.scrollPositionInPixels = state.scrollPositionInPixels+1;
        state.scrollPositionInPixels = state.scrollPositionInPixels-1;
    }

    var CHART_EDITOR_TOOLBOX_KEYCOUNT_LAYOUT:String = null;
    var keycountToolbox = null;
    var keycountToolboxInputKeycount = null;
    var keycountToolboxSave = null;
    var keycountToolboxLabelKeycount = null;

    var keycountMenuButton = null;
    function initKeyCountToolbox(state) {
        CHART_EDITOR_TOOLBOX_KEYCOUNT_LAYOUT = Paths.ui('chart-editor/toolbox/keycounts');

        //setup toolbox
        keycountToolbox = RuntimeComponentBuilder.fromString(Assets.getText(CHART_EDITOR_TOOLBOX_KEYCOUNT_LAYOUT), "xml");
        keycountToolbox.destroyOnClose = false;
        state.activeToolboxes.set(CHART_EDITOR_TOOLBOX_KEYCOUNT_LAYOUT, keycountToolbox);

        keycountToolboxLabelKeycount = keycountToolbox.findComponent("labelKeycount");
        keycountToolboxInputKeycount = keycountToolbox.findComponent("inputKeycount");
        keycountToolboxInputKeycount.onChange = function(event) {
            trace(keycountToolboxInputKeycount.value);
            if (keycountToolboxInputKeycount.value != Strumline.KEY_COUNT) {
                setCharterKeyCount(keycountToolboxInputKeycount.value);
                MultikeyKeyCountRegistry.setEntry(_lastSongID, _lastVariation, _lastDifficulty, Strumline.KEY_COUNT);
            }
        };
        refreshKeyCountToolbox();

        keycountToolboxSave = keycountToolbox.findComponent("keycountsToolboxSave");
        keycountToolboxSave.onClick = function(_) {
            var suffix:String = _lastVariation != Constants.DEFAULT_VARIATION ? "-" + _lastVariation : "";
            FileUtil.writeFileReference("keyCounts"+suffix+".json", SerializerUtil.toJSON(MultikeyKeyCountRegistry.fetchEntryRaw(_lastSongID, _lastVariation)), function(n) {});
        }


        //add keycount button into the window menu
        keycountMenuButton = RuntimeComponentBuilder.fromString(Assets.getText(Paths.ui('chart-editor/components/keycounts-menubar')), "xml");
        keycountMenuButton.onChange = function(event) {
            //trace(event.value); //doesnt cast correctly into a bool with hscript i guess?
            ChartEditorToolboxHandler.setToolboxState(FlxG.state, CHART_EDITOR_TOOLBOX_KEYCOUNT_LAYOUT, keycountMenuButton.selected);
            refreshKeyCountToolbox();
        }

        for (menu in state.menubar._compositeBuilder._menus) {
            if (menu.text == "Window") {
                menu.addComponent(keycountMenuButton);
            }
        }
    }

    function refreshKeyCountToolbox() {
        keycountToolboxInputKeycount.value = Strumline.KEY_COUNT;
        keycountToolboxLabelKeycount.text = "Key Count for " + FlxG.state.playbarDifficulty.text;
    }
}