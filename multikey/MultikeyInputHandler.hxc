class MultikeyInputHandler extends Module
{
    //public var onInputPressed:FlxTypedSignal<PreciseInputEvent->Void>;
    //public var onInputReleased:FlxTypedSignal<PreciseInputEvent->Void>;

    public function new() {
        super("MultikeyInputHandler");
    }

	//var _keyList = [FlxKey.A, FlxKey.S, FlxKey.D, FlxKey.F, FlxKey.H, FlxKey.J, FlxKey.K, FlxKey.L];
    var _keyList = [FlxKey.S, FlxKey.D, FlxKey.F, FlxKey.SPACE, FlxKey.J, FlxKey.K, FlxKey.L];
	var _keysHeld = [false, false, false, false, false, false, false, false, false];

	function initControls() {
		var controls = null;
		var path = Paths.file("data/defaultMultikeyControls.json");
        if (Assets.exists(path)) {
            controls = Json.parse(Assets.getText(path));
        } else {
            throw "Missing default multikey controls json!";
        }
		var stringMap = FlxKey.getStringMap();
		_keysHeld = [];
		_keyList = [];
		for (i in 0...Strumline.KEY_COUNT) _keysHeld.push(false);
		for (keys in controls.keyboard[Strumline.KEY_COUNT-1]) {
			trace(keys);
			_keyList.push(stringMap.get(keys[0]));
		}		
	}

    function handleKeyDown(keyCode:KeyCode, _:KeyModifier, timestamp:Int64):Void
    {
        var key:FlxKey = PreciseInputManager.convertKeyCode(keyCode);
		var index = _keyList.indexOf(key);
        if (index == -1 || PlayState.instance == null || Strumline.KEY_COUNT == 4) return;

        // TODO: Remove this line with SDL3 when timestamps change meaning.
        // This is because SDL3's timestamps are measured in nanoseconds, not milliseconds.
        timestamp *= Constants.NS_PER_MS; // 18126000000 38367000000

		if (!_keysHeld[index]) {
			if (PlayState.instance.isGamePaused) return;
			inputPressQueue.push({
				noteDirection: index,
				timestamp: timestamp
			});
		}
		_keysHeld[index] = true;
    }

    function handleKeyUp(keyCode:KeyCode, _:KeyModifier, timestamp:Int64):Void
    {
        var key:FlxKey = PreciseInputManager.convertKeyCode(keyCode);
		var index = _keyList.indexOf(key);
        if (index == -1 || PlayState.instance == null || Strumline.KEY_COUNT == 4) return;

        //trace(key);

        // TODO: Remove this line with SDL3 when timestamps change meaning.
        // This is because SDL3's timestamps ar e measured in nanoseconds, not milliseconds.
        timestamp *= Constants.NS_PER_MS;

		if (_keysHeld[index]) {
			if (PlayState.instance.isGamePaused) return;
			inputReleaseQueue.push({
				noteDirection: index,
				timestamp: timestamp
			});
		}
		_keysHeld[index] = false;
    }

    /*
    function handleButtonDown(gamepad:FlxGamepad, button:LimeGamepadButton, timestamp:Int64):Void
    {
        var buttonId:FlxGamepadInputID = FlxGamepadUtil.getInputID(gamepad, button);

        var buttonListEntry = _buttonList.get(gamepad.id);
