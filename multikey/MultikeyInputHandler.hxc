	var inPlayState:Bool = false;
    override function onStateChangeBegin(e) {
		if (inPlayState) {
			FlxG.stage.application.window.onKeyDownPrecise.remove(handleKeyDown);
        	FlxG.stage.application.window.onKeyUpPrecise.remove(handleKeyUp);
		}
		inPlayState = false;
	}
    override function onStateChangeEnd(e) {
		if (Std.isOfType(e.targetState, PlayState)) {
            inPlayState = true;
			FlxG.stage.application.window.onKeyDownPrecise.add(handleKeyDown);
        	FlxG.stage.application.window.onKeyUpPrecise.add(handleKeyUp);
			initControls();
        }
	}
	override public function onSubStateOpenEnd(event)
    {
        super.onSubStateOpenEnd(event);
        if (PlayState.instance == event.targetState) {
            FlxG.stage.application.window.onKeyDownPrecise.add(handleKeyDown);
        	FlxG.stage.application.window.onKeyUpPrecise.add(handleKeyUp);
			initControls();
        }
    }
	function onSongRetry(e) {
		initControls();
	}

	//custom input queue
	var inputPressQueue:Array<PreciseInputEvent> = [];
	var inputReleaseQueue:Array<PreciseInputEvent> = [];

	override function onUpdate(e) {
		if (PlayState.instance != null && Strumline.KEY_COUNT != 4) {
			//disable default input queue
			PlayState.instance.inputPressQueue = [];
      		PlayState.instance.inputReleaseQueue = [];

			processInputQueue();
			handleBFAnimHold();
		}
	}


	function processInputQueue():Void
	{
		if (inputPressQueue.length + inputReleaseQueue.length == 0) return;

		// Ignore inputs during cutscenes.
		if (PlayState.instance.isInCutscene || PlayState.instance.disableKeys)
		{
			inputPressQueue = [];
			inputReleaseQueue = [];
			return;
		}

		// Generate a list of notes within range.
		var notesInRange:Array<NoteSprite> = PlayState.instance.playerStrumline.getNotesMayHit();

		var notesByDirection:Array<Array<NoteSprite>> = [];
		for (i in 0...Strumline.KEY_COUNT) notesByDirection.push([]);

		for (note in notesInRange)
			notesByDirection[note.direction].push(note);

		while (inputPressQueue.length > 0)
		{
			var input:Null<PreciseInputEvent> = inputPressQueue.shift();
			if (input == null) continue;

			PlayState.instance.playerStrumline.pressKey(input.noteDirection);

			// Don't credit or penalize inputs in Bot Play.
			if (PlayState.instance.isBotPlayMode) continue;

			var notesInDirection:Array<NoteSprite> = notesByDirection[input.noteDirection];

			#if FEATURE_GHOST_TAPPING
			if ((!PlayState.instance.playerStrumline.mayGhostTap()) && notesInDirection.length == 0)
			#else
			if (notesInDirection.length == 0)
			#end
			{
				// Pressed a wrong key with no notes nearby.
				// Perform a ghost miss (anti-spam).
				PlayState.instance.ghostNoteMiss(input.noteDirection, notesInRange.length > 0);

				// Play the strumline animation.
				PlayState.instance.playerStrumline.playPress(input.noteDirection);
				//trace('PENALTY Score: ${songScore}');
			}
			else if (notesInDirection.length == 0)
			{
				// Press a key with no penalty.

				// Play the strumline animation.
				PlayState.instance.playerStrumline.playPress(input.noteDirection);
				//trace('NO PENALTY Score: ${songScore}');
			}
			else
			{
				// Choose the first note, deprioritizing low priority notes.
				var targetNote:Null<NoteSprite> = notesInDirection[0]; //notesInDirection.find((note) -> !note.lowPriority);
				if (targetNote == null) targetNote = notesInDirection[0];
				if (targetNote == null) continue;

				// Judge and hit the note.
				// trace('Hit note! ${targetNote.noteData}');
				PlayState.instance.goodNoteHit(targetNote, input);
				// trace('Score: ${songScore}');

				notesInDirection.remove(targetNote);

				// Play the strumline animation.
				PlayState.instance.playerStrumline.playConfirm(input.noteDirection);
			}
		}

		while (inputReleaseQueue.length > 0)
		{
			var input:Null<PreciseInputEvent> = inputReleaseQueue.shift();
			if (input == null) continue;

			// Play the strumline animation.
			PlayState.instance.playerStrumline.playStatic(input.noteDirection);

			PlayState.instance.playerStrumline.releaseKey(input.noteDirection);
		}

		PlayState.instance.playerStrumline.noteVibrations.tryNoteVibration();
  }

  function handleBFAnimHold() {
	if (!PlayState.instance.isMinimalMode && _keysHeld.contains(true)) {
		var bf = PlayState.instance.currentStage.getBoyfriend();
		if (bf != null) {
			//should be good enough to just keep it
			var targetTime = (bf.singTimeSteps * (Conductor.instance.stepLengthMs / Constants.MS_PER_SEC)) - 0.05;
			if (bf.holdTimer > targetTime) bf.holdTimer = targetTime;
		}
	}
  }
}